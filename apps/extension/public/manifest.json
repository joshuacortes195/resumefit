{
  "manifest_version": 3,
  "key": "",
  "name": "ResumeFit",
  "version": "0.8.0",
  "description": "Save jobs, scan them against your resume and have application forms filled in for you to check. It only presses Submit if you switch that on.",
  "action": { "default_title": "Open ResumeFit" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "externally_connectable": { "matches": ["http://localhost:3000/*", "https://resumefit-three.vercel.app/*"] },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" }
}
