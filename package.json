{
  "name": "resumefit",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter web lint",
    "test": "vitest run",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "test:e2e": "playwright test",
    "seed": "pnpm --filter web seed",
    "build:extension": "pnpm --filter @resumefit/extension build",
    "build:skills": "pnpm --filter @resumefit/skills-data build:skills"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "happy-dom": "^20.14.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
