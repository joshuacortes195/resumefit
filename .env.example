# copy this file to apps/web/.env.local and fill it in
# everything here is on a free tier, nothing needs a credit card

# supabase project settings > api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# supabase project settings > database > connection string (use the pooler one)
# leave it empty to run on a local database kept in apps/web/.data
DATABASE_URL=

# where the app runs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# optional: the id of the chrome extension, shown on chrome://extensions. with it set, connecting is one click
NEXT_PUBLIC_EXTENSION_ID=

# true means people need an invite code to sign up
INVITE_ONLY=true

# true shows the google button on the sign in page. turn google on as a provider in supabase first
GOOGLE_SIGN_IN=

# 32+ random characters, used to encrypt saved api keys (openssl rand -hex 32)
ENCRYPTION_KEY=

# optional: your own email. signing in with it needs no invite code and always makes you an admin
ADMIN_EMAIL=

# optional: 16+ random characters. vercel sends it with its scheduled visits, so only it can start the daily job refresh
CRON_SECRET=

# ai providers, tried left to right, all optional
AI_PROVIDER_ORDER=gemini,groq,cloudflare

# google ai studio free key, leave the models empty to use the defaults (gemini-3.8-flash and gemini-3.5-flash-lite)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FAST=

# groq free key, the default model is openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=

# cloudflare workers ai free allocation
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=
