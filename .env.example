# copy this file to apps/web/.env.local and fill it in
# everything here is on a free tier, nothing needs a credit card

# supabase project settings > api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# supabase project settings > database > connection string (use the pooler one)
DATABASE_URL=

# where the app runs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# true means people need an invite code to sign up
INVITE_ONLY=true

# 32+ random characters, used to encrypt saved api keys (openssl rand -hex 32)
ENCRYPTION_KEY=

# ai providers, tried left to right, all optional
AI_PROVIDER_ORDER=gemini,groq,cloudflare

# google ai studio free key
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FAST=

# groq free key
GROQ_API_KEY=
GROQ_MODEL=

# cloudflare workers ai free allocation
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=
